{
  "multipart": [
    { "when": { "damage": "0" }, "apply": { "model": "revivalages:block/chopping_block_0" } },
    { "when": { "damage": "0" }, "apply": { "model": "revivalages:block/chopping_block_bark_a" } },
    { "when": { "damage": "1" }, "apply": { "model": "revivalages:block/chopping_block_1" } },
    { "when": { "damage": "1" }, "apply": { "model": "revivalages:block/chopping_block_bark_b" } },
    { "when": { "damage": "2" }, "apply": { "model": "revivalages:block/chopping_block_2" } },
    { "when": { "damage": "2" }, "apply": { "model": "revivalages:block/chopping_block_bark_c" } },
    { "when": { "damage": "3" }, "apply": { "model": "revivalages:block/chopping_block_3" } },
    { "when": { "damage": "3" }, "apply": { "model": "revivalages:block/chopping_block_bark_d" } },
    { "when": { "damage": "4" }, "apply": { "model": "revivalages:block/chopping_block_4" } },
    { "when": { "damage": "4" }, "apply": { "model": "revivalages:block/chopping_block_bark_e" } },
    { "when": { "damage": "5" }, "apply": { "model": "revivalages:block/chopping_block_5" } },
    { "when": { "damage": "5" }, "apply": { "model": "revivalages:block/chopping_block_bark_f" } },
    { "when": { "sawdust": "1|2|3|4|5" }, "apply": { "model": "revivalages:block/chopping_block_sawdust_side" } },
    { "when": { "sawdust": "2|3|4|5" }, "apply": { "model": "revivalages:block/chopping_block_sawdust_side", "y": 90 } },
    { "when": { "sawdust": "3|4|5" }, "apply": { "model": "revivalages:block/chopping_block_sawdust_side", "y": 180 } },
    { "when": { "sawdust": "4|5" }, "apply": { "model": "revivalages:block/chopping_block_sawdust_side", "y": 270 } },
    { "when": { "sawdust": "5" }, "apply": { "model": "revivalages:block/chopping_block_sawdust_top" } }
  ]
}
